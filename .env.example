# Local development only. Copy to .env and choose a password before starting Postgres.
POSTGRES_HOST=127.0.0.1
POSTGRES_USERNAME=orkest
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_DB=orkest
DATABASE_URL=

# Local Keycloak and platform OIDC client.
KEYCLOAK_PORT=8082
OIDC_ISSUER_URL=http://localhost:8082/realms/orkest
OIDC_CLIENT_ID=orkest-web
OIDC_CLIENT_SECRET=orkest-local-secret
OIDC_REDIRECT_URL=http://127.0.0.1:8080/auth/callback
OIDC_COOKIE_SECURE=false

# Durable platform data root. Mount persistent disk here in deployed environments.
ORKEST_DATA_DIR=./data

# Both binaries read .env from their current working directory.
# CLI flags override these values; existing shell variables override .env.
AGENTCTL_LISTEN=127.0.0.1:8081
AGENTCTL_OPENCODE_BINARY=opencode
# Set absolute paths before calling /agent/launch. The work directory must exist.
AGENTCTL_WORK_DIR=
AGENTCTL_STATE_DIR=
