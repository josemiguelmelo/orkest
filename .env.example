# Local development only. Copy to .env and choose a password before starting Postgres.
POSTGRES_HOST=127.0.0.1
POSTGRES_USERNAME=orkest
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_DB=orkest
DATABASE_URL=

# Local Keycloak and platform OIDC client.
KEYCLOAK_PORT=8082
REGISTRY_PORT=5001
OIDC_ISSUER_URL=http://localhost:8082/realms/orkest
# Internal Compose address used for server-side OIDC discovery, token, and key requests.
OIDC_INTERNAL_ISSUER_URL=
OIDC_CLIENT_ID=orkest-web
OIDC_CLIENT_SECRET=orkest-local-secret
OIDC_REDIRECT_URL=http://127.0.0.1:8080/auth/callback
OIDC_COOKIE_SECURE=false

# Absolute host path shared with the Docker daemon for nested agent bind mounts.
# Compose expands PWD to the project directory. Use a daemon-visible path in deployments.
ORKEST_DATA_DIR=${PWD}/data
# Agent executor: docker (default), local, or kubernetes. Local runs host processes without task isolation.
ORKEST_EXECUTOR=docker
# Kubernetes requires an in-cluster platform Pod, an existing RWX PVC mounted at
# ORKEST_DATA_DIR/agent-executions, and matching non-root platform/worker UID/GID.
# ORKEST_KUBERNETES_NAMESPACE=
# ORKEST_KUBERNETES_INSTALLATION_ID=orkest
# ORKEST_KUBERNETES_DATA_PVC=
# ORKEST_KUBERNETES_DATA_SUBPATH=
# ORKEST_KUBERNETES_SERVICE_ACCOUNT=
# ORKEST_KUBERNETES_UID=1000
# ORKEST_KUBERNETES_GID=1000
# ORKEST_KUBERNETES_STARTUP_TIMEOUT=2m
# ORKEST_KUBERNETES_TERMINATION_GRACE_SECONDS=10
# Kubernetes platform Service DNS name and port used to derive worker MCP URL.
# The Service must route this port to the platform's HTTP_ADDR.
# ORKEST_KUBERNETES_PLATFORM_SERVICE_NAME=orkest
# ORKEST_KUBERNETES_PLATFORM_SERVICE_PORT=8080
# ORKEST_KUBERNETES_IMAGE_PULL_SECRETS=
# ORKEST_KUBERNETES_CODEX_AUTH_SECRET=
# ORKEST_KUBERNETES_CODEX_AUTH_SECRET_KEY=
# ORKEST_KUBERNETES_CPU_REQUEST=250m
# ORKEST_KUBERNETES_MEMORY_REQUEST=512Mi
# ORKEST_KUBERNETES_CPU_LIMIT=2
# ORKEST_KUBERNETES_MEMORY_LIMIT=4Gi
# Comma-separated host environment variable names explicitly granted to agent runtimes.
ORKEST_AGENT_PROVIDER_ENV=

# Application-wide Git author and committer identity for agent-created commits.
# Empty values use the defaults below. No provider-environment allowlist entry is needed.
ORKEST_GIT_AUTHOR_NAME=Orkest Agent
ORKEST_GIT_AUTHOR_EMAIL=agent@orkest.local

# Required for ORKEST_EXECUTOR=local; absolute path to an executable agentctl binary.
ORKEST_AGENTCTL_BINARY=

# Per-runtime agentctl images; defaults are pinned in the runtime catalog.
AGENTCTL_OPENCODE_IMAGE=orkest/agentctl-opencode:2.1.4
AGENTCTL_CLAUDE_CODE_IMAGE=orkest/agentctl-claude-code:0.99.0
AGENTCTL_CODEX_IMAGE=orkest/agentctl-codex:2.3.0
# Optional Codex auth file override. Local defaults to ~/.codex/auth.json when present;
# Docker requires an absolute host path visible to the Docker daemon. Kubernetes
# uses ORKEST_KUBERNETES_CODEX_AUTH_SECRET and *_KEY instead.
# ORKEST_CODEX_AUTH_FILE=
# Built webapp directory served by Go; build with make build.
ORKEST_WEB_DIR=./web/dist
# Required to create or update task integrations; use a unique 32-byte hex key.
ORKEST_INTEGRATION_ENCRYPTION_KEY=
# Optional MCP endpoint override for Docker/Local. Kubernetes derives the internal
# URL from ORKEST_KUBERNETES_PLATFORM_SERVICE_NAME and namespace instead.
ORKEST_AGENT_MCP_URL=
ORKEST_AGENT_MCP_TOKEN_KEY=

# Both binaries read .env from their current working directory.
# CLI flags override these values; existing shell variables override .env.
AGENTCTL_LISTEN=127.0.0.1:8081
# Set absolute paths before calling /agent/launch. The work directory must exist.
AGENTCTL_WORK_DIR=
AGENTCTL_STATE_DIR=

# Execution-profile composition (optional). Registry images are required for inputs.
ORKEST_EXECUTION_IMAGE_REPOSITORY=
# Maximum number of execution-profile builds handled concurrently (default: 1).
ORKEST_EXECUTION_PROFILE_BUILD_WORKERS=1
# Image builder backend: buildkit (default) or docker. Docker does not need buildctl.
ORKEST_IMAGE_BUILDER=buildkit
# Standalone mode uses a compatible BuildKit daemon; daemonless mode uses the
# buildctl-daemonless.sh wrapper (bundled in the platform Docker image).
ORKEST_BUILDCTL_BINARY=buildctl
ORKEST_BUILDKIT_DAEMONLESS=false
ORKEST_BUILDKIT_ADDR=unix:///run/buildkit/buildkitd.sock
ORKEST_BUILDKIT_TLS_CA=
ORKEST_BUILDKIT_TLS_CERT=
ORKEST_BUILDKIT_TLS_KEY=
