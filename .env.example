# Local development only. Copy to .env and choose a password before starting Postgres.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# agentctl reads .env from its current working directory.
# CLI flags override these values; existing shell variables override .env.
AGENTCTL_LISTEN=127.0.0.1:8081
AGENTCTL_OPENCODE_BINARY=opencode
# Set absolute paths before calling /agent/launch. The work directory must exist.
AGENTCTL_WORK_DIR=
AGENTCTL_STATE_DIR=
