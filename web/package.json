{
  "name": "orkest-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "generate:api": "node scripts/generate-api.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write src *.ts *.json scripts e2e",
    "format:check": "prettier --check src *.ts *.json scripts e2e",
    "test:live": "node scripts/smoke-live.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "radix-ui": "1.8.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.91.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
